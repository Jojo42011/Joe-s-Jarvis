ANTHROPIC_API_KEY=your_key_here
GEMINI_API_KEY=your_key_here
OPENAI_API_KEY=your_key_here
BRAVE_SEARCH_API_KEY=your_key_here
BRAVE_API_KEY=your_brave_search_api_key
GITHUB_TOKEN=your_github_personal_access_token
SEO_GITHUB_REPO=roanemeanbussiness-commits/Aquaticpools
SEO_GITHUB_BRANCH=main

VAPI_API_KEY=your_key_here
VAPI_SALES_AGENT_ID=your_sales_agent_id_here
VAPI_PHONE_NUMBER_ID=your_phone_number_id_here
VAPI_RECEPTIONIST_ID=your_receptionist_assistant_id_here

ARLO_MODEL=gpt-4o
ARLO_FAST_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_FAST_MODEL=claude-haiku-4-5-20251001
ARLO_MAX_TOKENS=8192

# Voice — ElevenLabs Scribe STT + TTS
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_STT_MODEL=scribe_v2_realtime
ELEVENLABS_STT_SILENCE_SECS=0.6
# Fallback voice/model — the operator personality's voiceId in config/personalities.ts
# overrides this at speak time; this only applies if that lookup fails.
ELEVENLABS_VOICE_ID=KLON7Nwan8mJxpF2R8Yw
# TTS tuning knobs (ARLO_TTS_* — the old ELEVENLABS_MODEL_ID/STABILITY/STYLE
# names are retired; stale Fly secrets under those names are ignored on purpose):
ARLO_TTS_MODEL=eleven_multilingual_v2
ARLO_TTS_STABILITY=0.6
ARLO_TTS_SIMILARITY=0.75
ARLO_TTS_STYLE=0
ARLO_TTS_SPEED=1.0
ARLO_TTS_SPEAKER_BOOST=true
SEO_GEMINI_MODEL=gemini-2.5-flash
SEO_WEBSITE_URL=https://your-website.com
# Where every link Paulie posts points. Defaults to SEO_WEBSITE_URL + /contact.
SEO_CONTACT_URL=

# Lauren — AI image generation for SEO pages (uses GEMINI_API_KEY, same as text)
SEO_IMAGE_MODEL=gemini-2.5-flash-image
SEO_IMAGE_ASPECT=16:9        # aspect ratio for generated images
SEO_IMAGE_MAX=4              # max distinct images generated per page (extra slots reuse these)
SEO_IMAGE_CDN=site           # site | jsdelivr | raw  (site = served from your repo/domain)
SEO_IMAGE_MIN_INTERVAL_MS=3000    # min spacing between image API calls
SEO_IMAGE_RETRIES=4               # retries on 429/5xx with backoff

# Lauren — local business identity (NAP / schema). Optional overrides:
# SEO_BIZ_NAME, SEO_BIZ_PHONE, SEO_BIZ_EMAIL, SEO_BIZ_STREET, SEO_BIZ_CITY,
# SEO_BIZ_STATE, SEO_BIZ_ZIP, SEO_BIZ_LAT, SEO_BIZ_LNG, SEO_BIZ_FOUNDING_YEAR,
# SEO_BIZ_POOLS_BUILT, SEO_BIZ_MIN_PROJECT, SEO_BIZ_SOCIALS (comma-separated)

OPENCLAW_HOOKS_TOKEN=your_openclaw_hooks_token

# SMS notifications — sms-gate.app (SMS Gateway for Android, cloud mode), HTTP Basic auth.
# Sofia/Arlo text Arthur when a new lead comes in. ROTATE the password and set these as secrets.
SMS_GATE_URL=https://api.sms-gate.app/3rdparty/v1/message
SMS_GATE_USERNAME=your_sms_gate_username
SMS_GATE_PASSWORD=your_sms_gate_password
SMS_NOTIFY_TO=+16027843600

# Google — Gmail + Calendar (native OAuth for all three mailboxes)
# One OAuth "Web application" credential authorizes all 3 accounts individually.
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=https://arthur-arlo.fly.dev/api/google/callback
# Optional tuning:
# GOOGLE_SYNC_MS=900000          # inbox/calendar poll interval (default 15 min)
# GOOGLE_INBOX_QUERY=in:inbox newer_than:7d
# GOOGLE_INBOX_MAX=15            # messages pulled per account per sync
# GOOGLE_CAL_DAYS=14             # calendar look-ahead window

PORT=3000
