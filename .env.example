# ── Totally Outdoors LLC — Aethon Intelligence platform ──
# Every value below is a placeholder. Create FRESH accounts/keys for Totally
# Outdoors — never reuse another client's credentials.

NODE_ENV=development
PORT=3000
DB_PATH=./data/arlo.db
PUBLIC_BASE_URL=https://totally-outdoors.fly.dev

# Core AI
# ANTHROPIC_API_KEY is REQUIRED — it powers Jarvis's brain (voice + chat),
# his eyes (image/document reading), and call/lead classification.
ANTHROPIC_API_KEY=your_key_here
GEMINI_API_KEY=your_key_here          # Lauren/Paulie image generation
BRAVE_API_KEY=your_brave_search_api_key   # Jarvis's live web search
BRAVE_SEARCH_API_KEY=your_key_here    # alias — either name works
# OPENAI_API_KEY is OPTIONAL — only used for semantic-memory embeddings.
# Without it, memory recall falls back to keyword + strength + recency scoring.
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
ARLO_WEB_SEARCH=1                     # set to 0 to disable Jarvis's web-search tool

# Lauren publishes SEO pages into the LIVE WEBSITE's repo — point this at
# Totally Outdoors' actual website repository (get from Joe; site is on Wix
# today, so this only applies once the site has a repo-backed home).
GITHUB_TOKEN=your_github_personal_access_token
SEO_GITHUB_REPO=your-org/totally-outdoors-website
SEO_GITHUB_BRANCH=main

# Vapi — the phone line
VAPI_API_KEY=your_key_here
VAPI_SALES_AGENT_ID=your_sales_agent_id_here
VAPI_PHONE_NUMBER_ID=your_phone_number_id_here
VAPI_RECEPTIONIST_ID=your_receptionist_assistant_id_here

# Arlo brain
ARLO_MODEL=gpt-4o
ARLO_FAST_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_FAST_MODEL=claude-haiku-4-5-20251001
ARLO_MAX_TOKENS=900
ARLO_TOOLS_ENABLED=1

# Auth (off by default — dashboard opens without login). Set AUTH_ENABLED=1 to
# require sign-in. OWNER_DEFAULT_PASSWORD seeds the first "joe" owner account;
# if unset, a random password is generated and printed once at first boot.
AUTH_ENABLED=0
OWNER_DEFAULT_PASSWORD=

# Voice — ElevenLabs Scribe STT + TTS
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_STT_MODEL=scribe_v2_realtime
ELEVENLABS_STT_SILENCE_SECS=0.6
# Pick/clone a voice for the operator persona and put its Voice ID here.
ELEVENLABS_VOICE_ID=your_voice_id_here
# TTS tuning knobs (ARLO_TTS_* — the old ELEVENLABS_MODEL_ID/STABILITY/STYLE
# names are retired; stale Fly secrets under those names are ignored on purpose).
# Keep ARLO_TTS_STYLE=0 — style > 0 causes word-level stutters.
ARLO_TTS_MODEL=eleven_multilingual_v2
ARLO_TTS_STABILITY=0.6
ARLO_TTS_SIMILARITY=0.75
ARLO_TTS_STYLE=0
ARLO_TTS_SPEED=1.0
ARLO_TTS_SPEAKER_BOOST=true

# Lauren — SEO engine
SEO_GEMINI_MODEL=gemini-2.5-flash
SEO_GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
SEO_WEBSITE_URL=https://www.totallyoutdoorsllc.com
# Where every link Paulie posts points. Defaults to SEO_WEBSITE_URL + /contact.
SEO_CONTACT_URL=

# Lauren — AI image generation for SEO pages (uses GEMINI_API_KEY, same as text)
SEO_IMAGE_MODEL=gemini-2.5-flash-image
SEO_IMAGE_ASPECT=16:9        # aspect ratio for generated images
SEO_IMAGE_MAX=4              # max distinct images generated per page (extra slots reuse these)
SEO_IMAGE_CDN=site           # site | jsdelivr | raw  (site = served from your repo/domain)
SEO_IMAGE_MIN_INTERVAL_MS=3000    # min spacing between image API calls
SEO_IMAGE_RETRIES=4               # retries on 429/5xx with backoff
SEO_IMAGE_SLOT_ATTEMPTS=3

# Lauren — local business identity (NAP / schema). Code defaults already carry
# Totally Outdoors' real facts; override here only if something changes:
# SEO_BIZ_NAME, SEO_BIZ_LEGAL_NAME, SEO_BIZ_PHONE, SEO_BIZ_EMAIL,
# SEO_BIZ_STREET, SEO_BIZ_CITY, SEO_BIZ_STATE, SEO_BIZ_STATE_FULL, SEO_BIZ_ZIP,
# SEO_BIZ_LAT, SEO_BIZ_LNG, SEO_BIZ_FOUNDING_YEAR, SEO_BIZ_PROJECTS_COMPLETED,
# SEO_BIZ_MIN_PROJECT, SEO_BIZ_PRICE_RANGE, SEO_BIZ_TAGLINE, SEO_BIZ_LOGO,
# SEO_BIZ_IMAGE, SEO_BIZ_SOCIALS (comma-separated)

# Paulie — social content (Zernio publishes to Instagram/Facebook)
ZERNIO_API_KEY=your_zernio_api_key
ZERNIO_BASE_URL=https://zernio.com/api/v1
RALPH_AUTOGEN_ENABLED=0
RALPH_AUTOGEN_TARGET=6
RALPH_AUTOGEN_PER_RUN=2
RALPH_AUTOPUBLISH_PER_RUN=1
RALPH_IMAGE_ASPECT=1:1
RALPH_LOGO_PATH=client/assets/totally-outdoors-logo.png
# Reel rendering (720x1280/24fps chosen to fit the 512MB VM — don't raise casually)
RALPH_REEL_FPS=24
RALPH_REEL_W=720
RALPH_REEL_H=1280
RALPH_REEL_FRAME_SEC=2.5

# CRM
CRM_AUTO_FOLLOWUP_ENABLED=0

# SMS notifications — Twilio (carrier-registered A2P 10DLC). Texts Joe when a
# new lead comes in, an invoice is due, materials are late, etc. All values are
# read at call time from env with NO baked-in fallback — set them as Fly
# secrets. Sends pass MessagingServiceSid only (never From), so Twilio picks
# the sender from the registered pool. TWILIO_SMS_FROM_NUMBER may exist as a
# secret but is deliberately not read.
TWILIO_SMS_ACCOUNT_SID=your_twilio_account_sid
TWILIO_SMS_AUTH_TOKEN=your_twilio_auth_token
TWILIO_MESSAGING_SERVICE_SID=your_twilio_messaging_service_sid
# Joe's cell number, E.164 format:
SMS_NOTIFY_TO=+1330XXXXXXX
# Break-glass fallback: set SMS_PROVIDER=sms-gate to route through the old
# sms-gate.app Android gateway instead of Twilio (default is twilio). The
# carrier-approved message template is applied on both paths.
# SMS_PROVIDER=twilio
# SMS_GATE_URL=https://api.sms-gate.app/3rdparty/v1/message
# SMS_GATE_USERNAME=
# SMS_GATE_PASSWORD=

# Google — Gmail + Calendar + Search Console (native OAuth)
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=https://totally-outdoors.fly.dev/api/google/callback
# Optional tuning:
# GOOGLE_SYNC_MS=900000          # inbox/calendar poll interval (default 15 min)
# GOOGLE_INBOX_QUERY=in:inbox newer_than:7d
# GOOGLE_INBOX_MAX=15            # messages pulled per account per sync
# GOOGLE_CAL_DAYS=14             # calendar look-ahead window

# Stripe (optional — payment links disabled entirely if unset; invoices still
# draft and send with "call the office to pay" wording)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# PUBLIC_URL=https://joes-jarvis.fly.dev

# Milestone billing: 0 (default) = invoices draft and wait for Joe's approval;
# 1 = auto-email the customer the moment a milestone comes due.
INVOICE_AUTO_SEND=0
